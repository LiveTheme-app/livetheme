# Same line endings on every clone, so a build from any OS packs the same asset bytes as the submitted APK (all LF).
* text=auto

*.java   text eol=lf
*.gradle text eol=lf
*.js     text eol=lf
*.cjs    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.py     text eol=lf
*.xml    text eol=lf
*.properties text eol=lf
gradlew  text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.apk  binary
*.zip  binary
*.jar  binary
*.png  binary
*.jpg  binary
*.webp binary
*.mp3  binary
