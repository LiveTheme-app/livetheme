<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every AlertDialog.Builder, date and time picker in the app picks these up: app colours and 76dp list rows; AppUi.carSize raises text and buttons. -->
    <style name="LiveTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/LiveTheme.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/LiveTheme.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/LiveTheme.Dialog</item>
    </style>
    <style name="LiveTheme.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorBackground">#FF1C1C1E</item>
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFC7C7CC</item>
        <item name="android:listPreferredItemHeightSmall">76dp</item>
        <item name="android:listPreferredItemHeight">76dp</item>
    </style>
</resources>
