<?xml version="1.0" encoding="utf-8"?>
<!-- Banner glyph: an info mark on a rounded systemBlue tile, like an iOS notification icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FF0A84FF"/><corners android:radius="11dp"/></shape></item>
    <item android:drawable="@drawable/ic_info" android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
</layer-list>
